# ── Banco (Supabase → Project Settings → Database → Connection string → "Transaction pooler")
DATABASE_URL=

# ── Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Segredos da aplicação (gere com: openssl rand -hex 32)
FIELD_ENCRYPTION_KEY=
CRON_SECRET=

# ── IA (opcional: sem chave, o assistente roda em "modo demonstração")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Transcrição de áudio (opcional; qualquer API compatível com /audio/transcriptions)
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# ── WhatsApp Cloud API. Cada clínica conecta o próprio número em Configurações → WhatsApp.
# As variáveis abaixo são só um fallback para instalação de clínica única.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── URL pública (usada para mostrar a URL do webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Somente desenvolvimento sem Supabase: login local contra Postgres puro
# AUTH_MODE=local
